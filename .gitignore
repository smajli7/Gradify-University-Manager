# =====================================
# Gradify - .gitignore
# =====================================

# ------------------------------
# Maven / Java
# ------------------------------
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
*.jar
*.war
*.ear
*.class
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ------------------------------
# IDE - IntelliJ IDEA
# ------------------------------
.idea/
*.iml
*.iws
*.ipr
out/
atlassian-ide-plugin.xml

# ------------------------------
# IDE - Eclipse
# ------------------------------
.project
.classpath
.settings/
.metadata/
bin/
tmp/
*.bak

# ------------------------------
# IDE - VS Code
# ------------------------------
.vscode/
*.code-workspace

# ------------------------------
# IDE - NetBeans
# ------------------------------
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/

# ------------------------------
# Node / Angular
# ------------------------------
node_modules/
dist/
.angular/
.npm/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.yarn/cache
.yarn/unplugged
.yarn/install-state.gz

# ------------------------------
# Logs
# ------------------------------
*.log
logs/
spring-boot-info.json

# ------------------------------
# OS Generated
# ------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ------------------------------
# Environment / Secrets
# ------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
application-local.yml
application-prod.yml

# ------------------------------
# Test / Coverage
# ------------------------------
coverage/
*.lcov
.nyc_output/
test-results/
junit.xml

# ------------------------------
# Temporary Files
# ------------------------------
*.tmp
*.temp
*.swp
*.swo
*~

# ------------------------------
# Documentation (large files)
# ------------------------------
# PDF files are excluded 
documentation/*.pdf

# ------------------------------
# Docker
# ------------------------------
.docker/

# ------------------------------
# Gradle (if used)
# ------------------------------
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

